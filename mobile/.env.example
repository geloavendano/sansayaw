# Same Supabase project as web/.env.local (NEXT_PUBLIC_SUPABASE_* there),
# just re-exposed under Vite's required VITE_ prefix. Anon key — safe to
# ship in the client bundle, gated by RLS (see migration_rls_hardening.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog project API key (Project Settings > API Keys in posthog.com).
# Public/write-only key — safe to ship in the client bundle. Analytics is a
# no-op if this is unset (see src/lib/analytics.ts), so the app runs fine
# without it while you're setting up the PostHog account.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
